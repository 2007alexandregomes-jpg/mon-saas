# Copie ce fichier en `.env.local` puis remplis les valeurs.
# `.env.local` est ignoré par Git : tes clés ne partiront JAMAIS sur GitHub.
#
# Où trouver ces valeurs :
#   Dashboard Supabase > ton projet > Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle_ici_la_cle_publishable_ou_anon

# L'URL publique du site, utilisée pour les redirections après connexion Google.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Higgsfield (génération vidéo) ---
# Créer les identifiants sur https://cloud.higgsfield.ai/api-keys
# ⚠️ PAS de préfixe NEXT_PUBLIC_ : ces valeurs doivent rester sur le serveur.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# --- Claude (analyse des vidéos) ---
# Créer une clé sur https://console.anthropic.com > API keys
# ⚠️ PAS de préfixe NEXT_PUBLIC_ : doit rester sur le serveur.
ANTHROPIC_API_KEY=

# --- Groq (transcription audio) ---
# Créer une clé sur https://console.groq.com/keys
GROQ_API_KEY=

# --- Supabase : clé de service (traitements de fond) ---
# Dashboard Supabase > Project Settings > API Keys > "secret" / "service_role"
# ⚠️ CONTOURNE toutes les politiques d'accès. PAS de préfixe NEXT_PUBLIC_.
#    Ne jamais la committer, ne jamais l'envoyer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- WaveSpeed (édition vidéo Kling O1) ---
# Créer une clé sur https://wavespeed.ai > API Keys
# ⚠️ PAS de préfixe NEXT_PUBLIC_ : doit rester sur le serveur.
WAVESPEED_API_KEY=
