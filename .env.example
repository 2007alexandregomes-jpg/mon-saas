# Copie ce fichier en `.env.local` puis remplis les valeurs.
# `.env.local` est ignoré par Git : tes clés ne partiront JAMAIS sur GitHub.
#
# Où trouver ces valeurs :
#   Dashboard Supabase > ton projet > Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle_ici_la_cle_publishable_ou_anon

# L'URL publique du site, utilisée pour les redirections après connexion Google.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
